# Copiá este archivo a .env.local y completá los valores.

# ── Stripe (sandbox "Purrsome LLC sandbox" → sk_test_...) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Link de login del portal de clientes (Dashboard → Settings → Billing → Customer portal)
NEXT_PUBLIC_STRIPE_PORTAL_URL=
# A dónde llegan los avisos de pagos (default: CUESTIONARIO_TO)
STRIPE_NOTIFY_TO=

# ── Resend (ya usado por el cuestionario) ──
RESEND_API_KEY=
CUESTIONARIO_TO=
CUESTIONARIO_FROM=
